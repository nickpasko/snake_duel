{
  "configVersion": 1,
  "id": "snake-duel",
  "version": "1.1.0",
  "title": {
    "en": "Snake Duel Arena",
    "ru": "Арена дуэли змей"
  },
  "entry": "index.html",
  "files": [
    "index.html",
    "style.css",
    "missions.js",
    "game.js"
  ],
  "sdk": "1.0.1",
  "locales": [
    "ru",
    "en"
  ],
  "orientation": "landscape",
  "input": [
    "mouse",
    "touch"
  ],
  "monetization": "ads",
  "placements": {
    "after_result": {
      "type": "interstitial",
      "minIntervalSec": 120
    }
  },
  "progress": [
    "mission"
  ],
  "storage": {
    "keys": [
      "missionProgress",
      "lang"
    ],
    "maxBytes": 4096,
    "legacy": {
      "missionProgress": {
        "local": "snakeDuelMissionProgress",
        "cloud": "missionProgress"
      },
      "lang": {
        "local": "snakeDuelLang",
        "cloud": "lang"
      }
    }
  },
  "assets": {
    "icon": "store-assets/icon-512.png",
    "cover": "store-assets/cover-800x470.png"
  },
  "releases": [
    {
      "platform": "crazygames",
      "region": "intl"
    },
    {
      "platform": "itch",
      "region": "intl"
    },
    {
      "platform": "yandex",
      "region": "ru"
    }
  ]
}
